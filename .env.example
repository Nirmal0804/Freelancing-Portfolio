# Zoho Mail SMTP Configuration
# For Zoho accounts in India / Global:
# SMTP_HOST=smtppro.zoho.in (or smtp.zoho.in / smtp.zoho.com)
# SMTP_PORT=587 (TLS) or 465 (SSL)
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=587
SMTP_USER=craftedweb@zohomail.in
SMTP_PASSWORD=your_zoho_app_password_here

# Destination Email where project enquiries will be received
CONTACT_EMAIL=craftedweb@zohomail.in
